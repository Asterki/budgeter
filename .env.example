# ─────────────────────────────────────────────────────────────────────────────
# Tasker environment template.  Copy to `.env.local` for local development and
# add the same keys to Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Public VAPID key. Must match VAPID_PUBLIC_KEY below. Exposed to the browser
# at build time (inlined as __VAPID_PUBLIC_KEY__ and import.meta.env).
VITE_VAPID_PUBLIC_KEY=

# Server-side push credentials. Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional shared secret. When set, Vercel Cron must present it as a bearer
# token (Vercel does this automatically for CRON_SECRET).
CRON_SECRET=

# Optional KV REST store for the reminder mirror. Any Upstash-compatible
# endpoint works. Without it the endpoint falls back to a warm in-memory map.
KV_REST_API_URL=
KV_REST_API_TOKEN=
